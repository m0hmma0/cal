rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- users/{uid} -----------------------------------------------------
    // Instructor creates/edits these documents manually from the Firebase
    // console (name, email, balance). Students may only read their own
    // profile, and may only adjust their own `balance` by exactly +/-1 per
    // write, which is what the app's booking/cancellation transactions do.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && (
          request.resource.data.balance == resource.data.balance - 1 ||
          request.resource.data.balance == resource.data.balance + 1
        );
    }

    // --- slots/{slotId} ----------------------------------------------------
    // Instructor creates/edits/deletes availability manually from the
    // console. Students may read all slots and may only flip `bookedCount`
    // by exactly +/-1 (and the derived `status`) when booking/cancelling.
    match /slots/{slotId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount', 'status'])
        && request.resource.data.capacity == resource.data.capacity
        && request.resource.data.bookedCount is int
        && request.resource.data.bookedCount >= 0
        && request.resource.data.bookedCount <= request.resource.data.capacity
        && (
          request.resource.data.bookedCount == resource.data.bookedCount - 1 ||
          request.resource.data.bookedCount == resource.data.bookedCount + 1
        );
    }

    // --- bookings/{bookingId} ----------------------------------------------
    // A student can only see and create their own bookings, and can only
    // ever transition their own booking from confirmed -> cancelled.
    match /bookings/{bookingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.studentId
        && request.resource.data.status == 'confirmed';
      allow update: if request.auth != null
        && request.auth.uid == resource.data.studentId
        && resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
  }
}
